# ─────────────────────────────────────────────────────────────────────────────
# server/.env.example  –  BACKEND (Node / Express)
# Copy to server/.env and fill in real values for local development.
# For production, set these as secure environment variables in your host
# (Render, Railway, Heroku, etc.) – do NOT commit real values.
# ─────────────────────────────────────────────────────────────────────────────


# ── Runtime ───────────────────────────────────────────────────────────────────

# Node environment.  Use "production" in Render/Railway/Heroku.
NODE_ENV=development

# TCP port the Express server listens on.
PORT=3000


# ── Database  [REQUIRED in production] ───────────────────────────────────────

# Full PostgreSQL connection string.
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/sereya_dev


# ── Authentication  [REQUIRED in production] ──────────────────────────────────

# Random secret used to sign JWTs.  Must be at least 32 characters long.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET


# ── Role-Based Access Control ─────────────────────────────────────────────────

# When "true", only the canonical lowercase "admin" role has super-admin access.
# Set to "false" only during a transitional migration period; remove once all
# legacy roles ("Admin", "شريك") have been normalized via `npm run normalizeAdmins`.
# Default: true
RBAC_STRICT_ADMIN=true


# ── Feature Flags ─────────────────────────────────────────────────────────────

# Enable the Google Drive OCR scanning feature (GET /api/scan-drive-pdfs, /api/sync-drive).
# Requires GOOGLE_APPLICATION_CREDENTIALS when enabled.
# Default: false  (endpoints return 404 when disabled)
FEATURE_DRIVE_OCR=false


# ── Google Sheets / Drive Integration  [optional] ─────────────────────────────

# Option A – inline JSON string of a Google service-account credentials blob.
# Recommended for platforms that support environment variables (Render, Railway).
# Example value (replace with your actual service-account JSON, on one line):
GOOGLE_SHEETS_CREDENTIALS=

# Option B – alias accepted by some internal helpers.
GOOGLE_CREDENTIALS=

# Option C – path to a credentials JSON file on disk (classic Application Default Credentials).
# Used by @google-cloud/* libraries and the Drive OCR service.
# Example: /etc/secrets/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=


# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# Example: https://sereya.example.com,https://staging.sereya.example.com
# Default (development fallback): http://localhost:5173
FRONTEND_URL=http://localhost:5173


# ── Admin Bootstrap  [used by db:seed:admin only] ────────────────────────────

# Required only when running:  npm run db:seed:admin
# These values are consumed once and never stored in plain text.
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD
