# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  FRONTEND (Vite)
# Copy this file to .env.development or .env.production and fill in real values.
# NEVER commit a file containing real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL that the browser uses to reach the backend API.
# Development: point to your local backend.
# Production:  use a relative path (/api) when frontend and backend share the same domain.
VITE_API_BASE_URL=http://localhost:3000/api
